# Used by `npm run dev:emulators` (vite --mode emulator) together with
# `npm run emulators`. Demo values only: "demo-*" project ids never touch a
# real Firebase project. Safe to commit.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cpp-hero.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cpp-hero
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_USE_EMULATORS=true
