# Cpp Hero cloud save (Google sign-in + Firestore sync). ALL OPTIONAL:
# leave them unset and the app works exactly as before (device-only save,
# no sign-in UI, Firebase never downloaded).
#
# Local: copy to .env.local (git-ignored) and fill in.
# Production: set the same names in Vercel > Project > Settings > Environment Variables.
# Values: Firebase console > Project settings > General > Your apps > Web app > SDK config.
# (A Firebase web config is not a secret: it ships in the JS bundle. Security comes
# from firestore.rules, authorized domains and App Check. Still, keep it out of git.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=            # e.g. your-project.firebaseapp.com (or your own domain, see docs/DEPLOY.md)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=         # optional
VITE_FIREBASE_MESSAGING_SENDER_ID=    # optional

# App Check (recommended in production; off when the site key is empty)
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise   # enterprise | v3
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Local testing with App Check on: "true" prints a debug token in the console
# (add it in Firebase console > App Check > Apps > Manage debug tokens).
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Local Emulator Suite instead of the real project (see npm run dev:emulators / .env.emulator)
VITE_FIREBASE_USE_EMULATORS=false
